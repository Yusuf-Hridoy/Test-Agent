{
  "name": "magpie-qa",
  "version": "1.0.0",
  "description": "The testing agent that remembers your app — a self-hosted, open-source web-testing agent with persistent memory: explore once, replay for free, heal when the app changes.",
  "license": "MIT",
  "author": "Yusuf-Hridoy",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yusuf-Hridoy/Test-Agent.git"
  },
  "homepage": "https://github.com/Yusuf-Hridoy/Test-Agent#readme",
  "bugs": {
    "url": "https://github.com/Yusuf-Hridoy/Test-Agent/issues"
  },
  "keywords": [
    "qa",
    "testing",
    "agent",
    "playwright",
    "llm",
    "regression",
    "exploratory"
  ],
  "bin": {
    "magpie": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@ai-sdk/mistral": "^2.0.0",
    "ai": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "minimatch": "^10.0.1",
    "playwright": "^1.47.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
